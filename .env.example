# Local values can be obtained with `supabase status` after `supabase start`.
# Never commit real keys and never expose the service role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
INTERNAL_JOB_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_ORIGIN=http://localhost:3000

# Optional local-only fallback while the content pack is being imported.
# GEO_CONTENT_SOURCE=database
